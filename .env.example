# Any service from the AI settings panel: anthropic, openai, gemini, openrouter,
# groq, mistral, deepseek, xai, ollama, lmstudio, custom, server.
# Development only: the key ends up in the page. Leave these empty to add a
# provider in the panel instead.
VITE_AI_SERVICE=
VITE_AI_MODEL=
VITE_AI_API_KEY=
# Only for custom and server, or to override a service's address.
VITE_AI_BASE_URL=
